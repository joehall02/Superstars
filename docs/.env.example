# Superstars Environment Variables

# Authentication
SITE_PASSWORD=your-site-password-here

# Google Cloud Storage - Private Bucket (spreadsheet)
GCS_PRIVATE_BUCKET=superstars-private
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# Google Cloud Storage - Public Bucket (images + configs)
GCS_PUBLIC_BUCKET=superstars-public
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/superstars-public

# Data Source (local = fetch from /data/superstars-data.json, api = fetch from /api/data endpoint)
VITE_DATA_SOURCE=local

# Environment
VITE_ENVIRONMENT=development
