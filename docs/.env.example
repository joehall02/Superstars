# Superstars Environment Variables

# Authentication
SITE_PASSWORD=your-site-password-here

# Google Cloud Storage - Private Bucket (spreadsheet)
GCS_PRIVATE_BUCKET=private_bucket_name
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# NOTE: Only VITE_-prefixed vars are exposed to the browser; everything above is server-only.

# Data Source (local = fetch from /data/master-scores.json, api = fetch from /api/convert-data endpoint)
VITE_DATA_SOURCE=local

# Public bucket base URL — used in the browser to build image/icon URLs and to fetch configs
# in prod (${VITE_GCS_PUBLIC_BASE_URL}/configs).
VITE_GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/public_bucket_name

AUTH_SECRET=really-secret-secret
